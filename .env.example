# General Configuration
SERVER_NAME=www.ngum-01.local
CLOUD_SERVER_NAME=line-menu.ngum-platform.com

# Compose Configuration
COMPOSE_PROFILES=core-services,cloud-services
COMPOSE_PROJECT_NAME=bzrv5_rev2 # pinned so moving the deploy dir does not start a second stack

# Secrets
## General
JWT_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
## MongoDB
MONGO_AUTH_DB=admin
MONGO_DB=bzr_v5
MONGO_REPLICA_SET=ngum-rs
MONGO_USERNAME=root
MONGO_PASSWORD=
## Redis
REDIS_PASSWORD=
## Clink wallet
CLINK_CLIENT_ID=
CLINK_CLIENT_SECRET=
CLINK_ENCRYPTION_KEY=
CLINK_CUSTOMER_BASE_URL=https://wallet-dev-customer.bitbuddy.dev
CLINK_MERCHANT_API_BASE_URL=https://wallet-dev-merchant-api.bitbuddy.dev

# Service Configuration
## EDC API
EDC_PAYMENT_EXPIRES_IN_SECONDS=600 # QR lifetime in seconds; invalid or empty falls back to 600

# Network Ports
## Global
MONGO_PORT=27017
REDIS_PORT=6379
## Core Services
SERVICE_AUTHENTICATOR_PORT=30001
SERVICE_FUNCTIONS_PORT=30002
SERVICE_MONGOSTREAM_PORT=30003
SERVICE_BACKOFFICE_PORT=30004
SERVICE_BACKOFFICE2_API_PORT=30005
SERVICE_BACKOFFICE2_WEB_PORT=30006
SERVICE_EDC_API_PORT=30007
SERVICE_EDC_WEB_PORT=30008 # Deprecated, will be removed in future versions
SERVICE_LINE_MENU_BOT_PORT=30009
## Cloud Services
SERVICE_MESSAGE_GATEWAY_PORT=30010
SERVICE_LINE_MENU_API_PORT=30011
SERVICE_LINE_MENU_WEB_PORT=30012
SERVICE_LINE_MENU_WEB_LITE_PORT=30013
SERVICE_LINE_DELIVERY_WEB_PORT=30014
SERVICE_RESERVATION_API_PORT=30015 # TODO: add to compose and nginx
SERVICE_RESERVATION_WEB_BACKOFFICE_PORT=30016 # TODO: add to compose and nginx
SERVICE_RESERVATION_WEB_FORM_PORT=30017 # TODO: add to compose and nginx
SERVICE_LINE_BINGO_WEB_PORT=30018
